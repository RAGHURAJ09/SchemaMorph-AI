# Application Environment
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-strong-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# For local dev with Docker Compose: postgresql://postgres:postgres_password@localhost:5432/schemamorph
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-...pooler.supabase.com:5432/postgres
# For local SQLite (no database needed): sqlite:///./schemamorph.db
DATABASE_URL=sqlite:///./schemamorph.db

# ── Docker only ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres_password

# ── AI Engine ─────────────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
